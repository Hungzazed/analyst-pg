# Jwt Configuration
JWT_ACCESS_SECRET=your_jwt_secret_key
JWT_ACCESS_EXPIRES_IN=3600s
JWT_REFRESH_SECRET=your_jwt_secret_key
JWT_REFRESH_EXPIRES_IN=2592000s

# fallback to JWT_SECRET for backward compatibility
JWT_SECRET=your_jwt_fallback_secret_key

# Redis Configuration
REDIS_URL=redis://localhost:6379
# PostgreSQL Configuration
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_SCHEMA=public
POSTGRES_MAX_POOL_SIZE=10
POSTGRES_IDLE_TIMEOUT_MS=30000
POSTGRES_CONNECTION_TIMEOUT_MS=10000

# Application
NODE_ENV=development
PORT=3000
FRONTEND_URL=http://localhost:3001